# Copy this file to .dev.vars and fill in the values
# Get these from the Discord Developer Portal

DISCORD_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_ID=
OWNER_DISCORD_ID=

# Optional: OpenFront API headers (leave empty to disable)
OPENFRONT_USER_AGENT=
OPENFRONT_CUSTOM_HEADER_NAME=x-deshack-access
OPENFRONT_CUSTOM_HEADER_VALUE=
